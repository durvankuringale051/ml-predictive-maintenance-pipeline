{
  "opcua": {
    "endpoint": "opc.tcp://192.168.10.20:4840",
    "base_node" : "ns=3;s=\"OPC_Data\".",
    "security": {
      "mode": "None",
      "policy": "None"
    },
    "subscription": {
      "publishing_interval": 1000,
      "lifetime_count": 100,
      "keepalive_count": 10
    },

    "debug" : {
      "write_csv" : true
    }

  },

  "plant": {
    "name": "Line1",

    "ml": {
          "vibration_model": "ML_model/rf_model.pkl",
          "state_classifier_model" : "ML_model/state_rf_model.pkl"
        },

    "machines": {
      "Motor_001": {
        "description": "Conveyor Motor",

        "signals": [
          "RPM",
          "Load",
          "ActualVibration",
          "ActualRUL"
        ]
      },

      "Motor_002": {
        "description": "Pump Motor",

        "signals": [
          "RPM",
          "Load",
          "ActualVibration",
          "Temp"
        ]
      }
    }
  }
}